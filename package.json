{
  "name": "vscode-deepseek-reasonix",
  "displayName": "DeepSeek-Reasonix",
  "description": "一键启动 Reasonix 终端，无需手动输入命令。One-click launch Reasonix terminal without typing commands.",
  "version": "1.4.1",
  "publisher": "pcbtool-net",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pcbtool/vscode-deepseek-reasonix.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "./logo.jpg",
  "main": "./extension.js",
  "activationEvents": [
    "onView:reasonix.sidebar"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reasonix",
          "title": "Reasonix",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "reasonix": [
        {
          "type": "webview",
          "id": "reasonix.sidebar",
          "name": "Reasonix"
        }
      ]
    },
    "commands": [
      {
        "command": "reasonix.launch",
        "title": "Reasonix: 启动终端"
      }
    ],
    "configuration": {
      "title": "Reasonix",
      "properties": {
        "reasonix.mode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "code",
            "chat"
          ],
          "enumDescriptions": [
            "自动检测 (v0.x TS → code, v1.x Go → chat)",
            "强制 npx reasonix code (v0.x 旧版 TypeScript，支持 Dashboard)",
            "强制 npx reasonix chat (v1.x 新版 Go，无 Dashboard)"
          ],
          "description": "Reasonix 启动模式 / Reasonix launch mode"
        }
      }
    }
  },
  "scripts": {
    "package": "npx @vscode/vsce package -o build/",
    "publish": "npx @vscode/vsce publish"
  }
}
